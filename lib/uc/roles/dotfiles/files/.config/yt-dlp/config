# Best AAC audio as m4a (no re-encoding), plays on Google Home, Alexa and iPad
-f "bestaudio[ext=m4a]/bestaudio"
-x
--audio-format m4a
--embed-metadata
--embed-thumbnail

# Don't download the whole Mix/playlist from a single video link
--no-playlist

# Remember what was downloaded
--download-archive ~/Music/archive.txt

# Output location and name
-o "~/Music/%(artist,uploader)s - %(title)s.%(ext)s"
--js-runtimes node
--remote-components ejs:github
