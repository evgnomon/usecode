# Swap Super and Left Alt on the built-in (AT/i8042) laptop keyboard and the
# Lofree Flow84.
#
# GNOME on Wayland applies xkb-options to every keyboard, so the old
# altwin:swap_alt_win autostart swapped every keyboard at once. Doing it
# here keeps the swap scoped per device; other external keyboards
# (Logitech receiver, dock) are left untouched.
#
# 0x38 = left alt, 0xdb = left meta (e0 5b) in AT scancode set 1.
evdev:atkbd:dmi:bvn*:bvr*:bd*:svnSamsung:pnGalaxyBook6Pro-PAMB:*
 KEYBOARD_KEY_38=leftmeta
 KEYBOARD_KEY_db=leftalt

# Lofree Flow84 over USB (388d:0002, shows up as "Flow2@Lofree").
# 0x700e2 = left alt, 0x700e3 = left GUI in the HID keyboard usage page.
evdev:input:b0003v388Dp0002*
 KEYBOARD_KEY_700e2=leftmeta
 KEYBOARD_KEY_700e3=leftalt
