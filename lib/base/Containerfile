# The workspace image: a Debian trixie dev box that `uc workspace` runs on
# the cluster, reached over SSH as you. Build context: lib/base.
FROM docker.io/library/debian:trixie

ENV DEBIAN_FRONTEND=noninteractive LANG=C.UTF-8
RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      bash-completion build-essential ca-certificates curl dnsutils file git \
      gnupg htop iproute2 iputils-ping jq less locales lsof make man-db \
      openssh-client openssh-server pkg-config procps python3 python3-venv \
      ripgrep rsync sudo tar tini tmux unzip vim wget xz-utils zip \
 && rm -rf /var/lib/apt/lists/*

# A quiet login: no uname line or Debian notice, and a UTF-8 locale for
# every session. Your laptop's LANG and LC_* stay home, so a locale the box
# doesn't have never warns; en_US.UTF-8 is there if you set it yourself.
RUN rm -f /etc/motd /etc/update-motd.d/* \
 && sed -i 's/^# *\(en_US.UTF-8 UTF-8\)/\1/' /etc/locale.gen && locale-gen \
 && echo LANG=C.UTF-8 >/etc/default/locale \
 && sed -i '/^AcceptEnv/d' /etc/ssh/sshd_config

# No users here: the entrypoint makes the one `uc workspace up` names, so
# you log in as yourself.
RUN rm -f /etc/ssh/ssh_host_*

COPY sshd_config /etc/ssh/sshd_config.d/usecode.conf
COPY entrypoint.sh /usr/local/sbin/usecode-workspace

EXPOSE 22
ENTRYPOINT ["/usr/bin/tini", "--", "/usr/local/sbin/usecode-workspace"]
