# Copy to .env and adjust. All vars are prefixed USECODE_AGENT_ and optional.

# USECODE_AGENT_OTP_LENGTH=6
# USECODE_AGENT_OTP_TTL_SECONDS=300
# USECODE_AGENT_OTP_RESEND_COOLDOWN_SECONDS=60
# USECODE_AGENT_OTP_MAX_ATTEMPTS=5

# Set to false once a real SMS provider is configured below.
# USECODE_AGENT_DEBUG_EXPOSE_OTP=true

# Generic HTTP SMS provider. Leave unset to just log codes to the console.
# USECODE_AGENT_SMS_API_URL=https://sms-provider.example.com/send
# USECODE_AGENT_SMS_API_KEY=your-provider-api-key
# USECODE_AGENT_SMS_SENDER_NAME=usecode agent

# USECODE_AGENT_CORS_ORIGINS=["http://localhost:5173"]

# PostgreSQL connection string. deploy/compose.yml sets this automatically to
# point at the bundled `postgres` service; override here for local dev
# against a different database.
# USECODE_AGENT_DATABASE_URL=postgresql+asyncpg://usecode-agent:usecode-agent@localhost:5432/usecode-agent

# Used to encrypt per-user secrets (e.g. Hetzner API tokens) at rest. Set a
# random value in production; rotating it invalidates every stored secret.
# USECODE_AGENT_SECRET_KEY=change-me-to-a-random-value
