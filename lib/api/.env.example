# Copy to .env and adjust. All vars are prefixed USECODE_AGENT_; only
# USECODE_AGENT_NODE_NAME is required. Variables already set in the
# environment take precedence over this file.

# This instance's name, e.g. api-1. The process refuses to start without it.
# USECODE_AGENT_NODE_NAME=api-1

# Address the HTTP server listens on.
# USECODE_AGENT_BIND=0.0.0.0:8000

# USECODE_AGENT_OTP_LENGTH=6
# USECODE_AGENT_OTP_TTL_SECONDS=300
# USECODE_AGENT_OTP_RESEND_COOLDOWN_SECONDS=60
# USECODE_AGENT_OTP_MAX_ATTEMPTS=5

# Set to false once a real SMS provider is configured below.
# USECODE_AGENT_DEBUG_EXPOSE_OTP=true

# Generic HTTP SMS provider. Leave unset to just log codes to the console.
# USECODE_AGENT_SMS_API_URL=https://sms-provider.example.com/send
# USECODE_AGENT_SMS_API_KEY=your-provider-api-key
# USECODE_AGENT_SMS_SENDER_NAME=usecode agent

# USECODE_AGENT_CORS_ORIGINS=["http://localhost:5173"]

# PostgreSQL connection string of the main database. deploy/compose.yml sets
# this automatically to point at the bundled `postgres-1` service; override
# here for local dev against a different database. The older
# postgresql+asyncpg:// spelling is accepted too.
# USECODE_AGENT_DATABASE_URL=postgresql://usecode_agent:usecode_agent@localhost:5432/usecode_agent

# The other database instances, keyed by partition key, as host:port/database.
# USECODE_AGENT_SHARDS={"b": "localhost:5433/usecode_agent"}

# Container tooling for /models/*: podman (default) or docker.
# USECODE_AGENT_MODEL_CONTAINER_CLI=podman

# Used to encrypt per-user secrets (e.g. Hetzner API tokens) at rest. Set a
# random value in production; rotating it invalidates every stored secret.
# USECODE_AGENT_SECRET_KEY=change-me-to-a-random-value
