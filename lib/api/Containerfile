FROM docker.io/library/rust:1-bookworm AS build

WORKDIR /src
COPY Cargo.toml Cargo.lock ./
COPY src ./src
COPY migrations ./migrations
COPY templates ./templates
COPY static ./static
COPY model_image ./model_image
# The registry and target/ live in cache mounts, so a rebuild only
# recompiles what changed. PROFILE=release gives the LTO'd binary.
# sharing=locked serialises api-1/api-2 building in parallel.
ARG PROFILE=local
RUN --mount=type=cache,target=/usr/local/cargo/registry,sharing=locked \
    --mount=type=cache,target=/src/target,sharing=locked \
    cargo build --profile "$PROFILE" --locked \
    && cp "target/$PROFILE/usecode-agent-api" /usr/local/bin/

FROM docker.io/library/debian:trixie-slim

# podman-remote talks to the host's podman over the socket mounted at
# /run/podman/podman.sock (see deploy/compose.yml + CONTAINER_HOST env var).
# It's what model_process.rs shells out to as "podman" to build/run/stop the
# usecode-agent-model container on the host. curl is for the healthcheck.
RUN apt-get update && apt-get install -y --no-install-recommends \
        podman-remote ca-certificates curl \
    && rm -rf /var/lib/apt/lists/* \
    && ln -s /usr/bin/podman-remote /usr/local/bin/podman

COPY --from=build /usr/local/bin/usecode-agent-api /usr/local/bin/usecode-agent-api

ENV USECODE_AGENT_BIND=0.0.0.0:8000
EXPOSE 8000

CMD ["usecode-agent-api"]
