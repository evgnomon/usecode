FROM python:3.12-slim AS base

# podman-remote talks to the host's podman over the socket mounted at
# /run/podman/podman.sock (see deploy/compose.yml + CONTAINER_HOST env var).
# It's what model_process.py shells out to as "podman" to build/run/stop the
# usecode-agent-model container on the host.
RUN apt-get update && apt-get install -y --no-install-recommends podman-remote \
    && rm -rf /var/lib/apt/lists/* \
    && ln -s /usr/bin/podman-remote /usr/local/bin/podman

RUN pip install --no-cache-dir uv

WORKDIR /app

COPY pyproject.toml uv.lock README.md ./
RUN uv sync --frozen --no-install-project --no-dev

COPY src ./src
COPY alembic.ini ./alembic.ini
COPY migrations ./migrations
RUN uv sync --frozen --no-dev

ENV PATH="/app/.venv/bin:${PATH}"

EXPOSE 8000

CMD ["uvicorn", "usecode_agent_api.app:app", "--host", "0.0.0.0", "--port", "8000"]
