# Copy to .env and adjust. All vars are prefixed USECODE_AGENT_BOT_ and optional.

# USECODE_AGENT_BOT_API_BASE_URL=https://localhost:4430/api
# USECODE_AGENT_BOT_API_KEY=api-key-from-auth-otp-verify
# USECODE_AGENT_BOT_REQUEST_TIMEOUT_SECONDS=10
# Set to false to skip TLS verification against Caddy's self-signed local cert.
# USECODE_AGENT_BOT_API_VERIFY_SSL=true
