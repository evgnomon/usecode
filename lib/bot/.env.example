# Copy to .env and adjust. All vars are prefixed USECODE_MCP_ and optional.

# Defaults to the hosted service at https://usecode.dev/api. For the local
# stack from deploy/compose.yml, point it at both Caddy load balancers:
# USECODE_MCP_API_BASE_URLS=http://localhost:8430/api,http://localhost:8431/api
# USECODE_MCP_API_BASE_URL=https://usecode.dev/api
# USECODE_MCP_API_KEY=api-key-from-auth-otp-verify
# USECODE_MCP_REQUEST_TIMEOUT_SECONDS=10
# Set to false to skip TLS verification for an https:// endpoint with a
# self-signed certificate.
# USECODE_MCP_API_VERIFY_SSL=true
# USECODE_MCP_COMPOSE_FILE=/path/to/usecode/deploy/compose.yml
# USECODE_MCP_CONTAINER_CLI=podman
