#!/bin/sh
# License-Identifier: HGL
# Copyright (C) The Usecode Authors (see AUTHORS)

# The same as `usecoded setup` does for a copied binary: enable the
# service and (re)start it on the new binary.

set -e

if [ -d /run/systemd/system ]; then
    systemctl daemon-reload
    systemctl enable --quiet usecode
    systemctl restart usecode
fi

exit 0
