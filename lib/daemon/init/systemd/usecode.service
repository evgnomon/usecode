# The usecode daemon: the one service on every host. What it does is the
# sum of its modules (today the WireGuard mesh); each one sets its part
# of the host up once what it needs is there, and a module that can't
# yet only logs a note and tries again - it never fails the service.

[Unit]
Description=usecode daemon
Documentation=https://github.com/evgnomon/usecode
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/usecoded run
# SIGHUP makes every module converge again, e.g. after
# `uc net mesh apply` delivered a new config.
ExecReload=/bin/kill -HUP $MAINPID

# Full root, deliberately: the daemon's job is setting the host up -
# installing packages, writing /etc, managing interfaces and firewall
# rules - and every new module needs more of that, not less.
User=root
Group=root

Restart=always
RestartSec=5
# Stopping takes each module down, e.g. the tunnel and its forwards.
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
