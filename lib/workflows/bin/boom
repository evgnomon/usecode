#!/bin/bash

set -euo pipefail

usage() {
    echo "Usage: $0 [-c] [-f] <filename>"
    echo "  encrypt <file>       -> <file>.asc  (original removed after verified round-trip)"
    echo "  decrypt <file>.asc   -> <file>      (.asc kept)"
    echo "  -c  write decrypted plaintext to stdout instead of a file"
    echo "  -f  overwrite an existing output file"
    exit 1
}

to_stdout=0
force=0
while getopts ":cfh" opt; do
    case "$opt" in
        c) to_stdout=1 ;;
        f) force=1 ;;
        *) usage ;;
    esac
done
shift $((OPTIND - 1))

[ $# -eq 1 ] || usage
filename="$1"

if [ ! -f "$filename" ]; then
    echo "Error: File '$filename' does not exist" >&2
    exit 1
fi

CIPHER=(-aes-256-cbc)
tmpdir="$(mktemp -d "${TMPDIR:-/tmp}/boom.XXXXXX")"
trap 'rm -rf "$tmpdir"' EXIT

read_pass() {
    local prompt="$1" p
    read -rsp "$prompt" p < /dev/tty
    echo >&2
    printf '%s' "$p"
}

if [[ "$filename" == *.asc ]]; then
    # ---------- decrypt ----------
    plain="${filename%.asc}"
    if [ "$to_stdout" -eq 0 ] && [ -e "$plain" ] && [ "$force" -eq 0 ]; then
        echo "Error: '$plain' already exists (use -f to overwrite, -c for stdout)" >&2
        exit 1
    fi

    # Normalize: drop CR, spaces and blank lines, then decode ourselves so a
    # missing/extra trailing newline or stray whitespace cannot break the decode.
    if ! tr -d ' \t\r\n' < "$filename" | base64 -d > "$tmpdir/raw" 2>/dev/null; then
        echo "Error: '$filename' is not valid base64 (truncated or corrupted?)" >&2
        exit 1
    fi
    if [ ! -s "$tmpdir/raw" ]; then
        echo "Error: '$filename' decoded to nothing" >&2
        exit 1
    fi

    BOOM_PASS="$(read_pass 'enter decryption password: ')"
    export BOOM_PASS

    # Try the current KDF, then the pre-OpenSSL-3.0 default used by older files.
    if openssl enc "${CIPHER[@]}" -d -pbkdf2 -in "$tmpdir/raw" -out "$tmpdir/plain" \
            -pass env:BOOM_PASS 2>/dev/null; then
        :
    elif openssl enc "${CIPHER[@]}" -d -md md5 -in "$tmpdir/raw" -out "$tmpdir/plain" \
            -pass env:BOOM_PASS 2>/dev/null; then
        echo "Note: decrypted with the legacy (-md md5) KDF; re-encrypt to upgrade." >&2
    else
        echo "Error: decryption failed (wrong password, or file not produced by boom)" >&2
        exit 1
    fi
    unset BOOM_PASS

    if [ "$to_stdout" -eq 1 ]; then
        cat "$tmpdir/plain"
    else
        cp "$tmpdir/plain" "$plain.boom.$$" && mv "$plain.boom.$$" "$plain"
        echo "Decrypted to $plain" >&2
    fi
else
    # ---------- encrypt ----------
    output="${filename}.asc"
    if [ -e "$output" ] && [ "$force" -eq 0 ]; then
        echo "Error: '$output' already exists (use -f to overwrite)" >&2
        exit 1
    fi

    p1="$(read_pass 'enter encryption password: ')"
    p2="$(read_pass 'verify encryption password: ')"
    if [ "$p1" != "$p2" ]; then
        echo "Error: passwords do not match" >&2
        exit 1
    fi
    if [ -z "$p1" ]; then
        echo "Error: empty password" >&2
        exit 1
    fi
    BOOM_PASS="$p1"
    export BOOM_PASS

    openssl enc "${CIPHER[@]}" -pbkdf2 -salt -in "$filename" -out "$tmpdir/enc" \
        -a -pass env:BOOM_PASS

    # Verify the round-trip before destroying the original.
    tr -d ' \t\r\n' < "$tmpdir/enc" | base64 -d > "$tmpdir/raw"
    openssl enc "${CIPHER[@]}" -d -pbkdf2 -in "$tmpdir/raw" -out "$tmpdir/check" \
        -pass env:BOOM_PASS
    unset BOOM_PASS
    if ! cmp -s "$filename" "$tmpdir/check"; then
        echo "Error: round-trip verification failed; original left untouched" >&2
        exit 1
    fi

    cp "$tmpdir/enc" "$output.boom.$$" && mv "$output.boom.$$" "$output"
    rm "$filename"
    echo "File encrypted as $output and original file removed"
fi
