#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
ENV_FILE="${ENV_FILE:?ENV_FILE must be set}"

compose() {
  podman-compose -p "${TENANT}_${NAMESPACE}_${POD}_powerdns" --env-file "$ENV_FILE" -f "$SCRIPT_DIR/../deploy/podman/podman-compose.yaml" "$@"
}

load_env() {
  set -a
  source "$ENV_FILE"
  set +a
}

ensure_networks() {
  load_env
  podman network exists "z-${TENANT}" 2>/dev/null || podman network create "z-${TENANT}"
  podman network exists "z-${TENANT}-${NAMESPACE}" 2>/dev/null || podman network create "z-${TENANT}-${NAMESPACE}"
  podman network exists "z-${TENANT}-${NAMESPACE}-${POD}" 2>/dev/null || podman network create "z-${TENANT}-${NAMESPACE}-${POD}"
}

make_volume() {
  load_env
  local data_dir="/mnt/z/volumes/$TENANT/$NAMESPACE/$POD/powerdns_data"
  mkdir -p "$data_dir"
  if [[ ! -f "$data_dir/pdns.sqlite3" ]]; then
    podman run --rm \
      --user 0:0 \
      -v "$data_dir:/seed" \
      --entrypoint sh \
      docker.io/powerdns/pdns-auth-49:latest \
      -c "cp /var/lib/powerdns/pdns.sqlite3 /seed/pdns.sqlite3 && chown -R 953:953 /seed"
  fi

  local admin_dir="/mnt/z/volumes/$TENANT/$NAMESPACE/$POD/powerdns_admin_data"
  mkdir -p "$admin_dir"
  podman run --rm \
    --user 0:0 \
    -v "$admin_dir:/seed" \
    --entrypoint sh \
    docker.io/powerdnsadmin/pda-legacy:latest \
    -c "chown -R 100:101 /seed"
}

backup() {
  load_env
  compose pause
  sudo tar -czf "$PLAT_HOME/$TENANT/$NAMESPACE/$POD/powerdns_backup.tar.gz" -C "/mnt/z/volumes/$TENANT/$NAMESPACE/$POD" .
  compose unpause
}

restore() {
  load_env
  compose down -v
  sudo rm -rf "/mnt/z/volumes/$TENANT/$NAMESPACE/$POD"
  make_volume
  sudo tar -xpzf "$PLAT_HOME/$TENANT/$NAMESPACE/$POD/powerdns_backup.tar.gz" -C "/mnt/z/volumes/$TENANT/$NAMESPACE/$POD"
  compose up -d
}

PLAT_HOME="${PLAT_HOME:-$HOME/.plat}"

while [[ $# -gt 0 ]]; do
  case "$1" in
    up)
      ensure_networks
      make_volume
      compose up -d
      shift
      ;;
    down)
      compose down -v
      shift
      ;;
    destroy)
      compose down -v
      sudo rm -rf "/mnt/z/volumes/$TENANT/$NAMESPACE/$POD/powerdns_data" \
        "/mnt/z/volumes/$TENANT/$NAMESPACE/$POD/powerdns_admin_data"
      shift
      ;;
    restart|logs)
      compose "$1"
      shift
      ;;
    backup)
      backup
      shift
      ;;
    restore)
      restore
      shift
      ;;
    *)
      echo "Unknown action: $1"
      exit 1
      ;;
  esac
done
