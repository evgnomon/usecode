{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "llama.cpp": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "llama.cpp (local)",
      "options": {
        "baseURL": "http://127.0.0.1:8080/v1"
      },
      "models": {
        "local-model": {
          "name": "Qwen3 0.6B (local)",
          "limit": {
            "context": 32768,
            "output": 8192
          }
        }
      }
    }
  },
  "mcp": {
    "usecode": {
      "type": "local",
      "command": [
        "usecode-mcp"
      ],
      "environment": {
        "USECODE_MCP_API_BASE_URL": "https://localhost:4430/api"
      },
      "enabled": true
    }
  }
}
